#!/bin/bash
# hrwm autostart, ported from ~/.config/herbstluftwm/autostart.
# hrwm runs this at startup and again on `hrwm reload` (Mod-Control-r).

dir=~/.config/hrwm

function hc() {
    hrwm "$@"
}

# picks a wallpaper and relinks ~/.colors (its feh/xrdb steps are X-only and
# harmlessly do nothing here; swaybg below shows the wallpaper)
~/.bin/wp change >/dev/null 2>&1
source ~/.colors
source $dir/config

hc emit_hook reload

# remove all existing keybindings
hc keyunbind --all

# was `setxkbmap -option caps:swapescape` in ~/.autostart.system
hc keymap us "" caps:swapescape

# touchpad: tap to click, ignore it while typing, traditional scrolling
# (`hrwm list_inputs` shows each device's current settings)
hc input tap on
hc input dwt on
hc input natural_scroll off

# tags
TAG_NAMES=( z x c v b n m )
TAG_KEYS=( z x c v b n m )

hc set default_frame_layout $default_frame_layout

hc rename default "${TAG_NAMES[0]}" || true
for i in ${!TAG_NAMES[@]} ; do
    hc add "${TAG_NAMES[$i]}"
    key="${TAG_KEYS[$i]}"
    if ! [ -z "$key" ] ; then
        hc keybind "$Mod-$key" use "${TAG_NAMES[$i]}"
        hc keybind "$Mod-Shift-$key" move "${TAG_NAMES[$i]}"
    fi
done

# Quit or Reload
hc keybind Control-Alt-Delete quit
hc keybind $Mod-Control-r reload

# Closing or opening programs
hc keybind $Mod-w close_or_remove
hc keybind $Mod-Return spawn $terminal
# fuzzel replaces dmenu + j4-dmenu-desktop
fuzzel=( fuzzel --font "$font" --background-color "${COLOR0#\#}ff" --text-color "${COLOR11#\#}ff"
         --selection-color "${COLOR2#\#}ff" --selection-text-color 000000ff
         --border-color "${COLOR9#\#}ff" --border-radius 0 )
hc keybind $Mod-d spawn "${fuzzel[@]}"

# cycle through tags
hc keybind $Mod-period use_index +1 --skip-visible
hc keybind $Mod-comma  use_index -1 --skip-visible
hc keybind $Mod-Right use_index +1 --skip-visible
hc keybind $Mod-Left  use_index -1 --skip-visible
hc keybind $Mod-a use_previous

# layouting
hc keybind $Mod-r remove
# only vertical and horizontal; from auto this flips to the other one
hc keybind $Mod-space cycle_layout 1 vertical horizontal

# what the old `split` script did: split, then move the window into the new frame
hc keybind $Mod-u       chain , split bottom $vertical_split     , shift -e down
hc keybind $Mod-o       chain , split left   $horizontal_split_i , shift -e left
hc keybind $Mod-Shift-u chain , split top    $vertical_split_i   , shift -e up
hc keybind $Mod-Shift-o chain , split right  $horizontal_split   , shift -e right

hc keybind $Mod-s floating toggle
hc keybind $Mod-f fullscreen toggle
hc keybind $Mod-p pseudotile toggle
hc keybind $Mod-Shift-f attr clients.focus.floating toggle
hc keybind $Mod-0 spawn $dir/padding "${fuzzel[@]}"

# resizing
RESIZESTEP=0.05
hc keybind $Mod-Control-h resize left +$RESIZESTEP
hc keybind $Mod-Control-j resize down +$RESIZESTEP
hc keybind $Mod-Control-k resize up +$RESIZESTEP
hc keybind $Mod-Control-l resize right +$RESIZESTEP

# mouse (dragging a tiled window floats it)
hc mouseunbind --all
hc mousebind $Mod-Button1 move
hc mousebind $Mod-Button2 zoom
hc mousebind $Mod-Button3 resize

# focus
hc keybind $Mod-BackSpace   cycle_monitor
hc keybind $Mod-slash   cycle_monitor
hc keybind $Mod-Tab         cycle +1
hc keybind $Mod-Shift-Tab   cycle -1
hc keybind $Mod-h focus left
hc keybind $Mod-j focus down
hc keybind $Mod-k focus up
hc keybind $Mod-l focus right
hc keybind $Mod-Shift-h shift left
hc keybind $Mod-Shift-j shift down
hc keybind $Mod-Shift-k shift up
hc keybind $Mod-Shift-l shift right
hc keybind $Mod-Shift-i rotate
hc keybind $Mod-g jumpto urgent

# what the old `swap` script did
hc keybind $Mod-Alt-h swap left
hc keybind $Mod-Alt-j swap down
hc keybind $Mod-Alt-k swap up
hc keybind $Mod-Alt-l swap right

# Lock screen
hc keybind $Mod-F3 spawn swaylock -f -i ~/.wallpapers/1v3X3.jpg

# Backlight; -e makes the 10% steps even to the eye instead of linear in
# the raw value (which barely changes near the top and jumps near the bottom)
hc keybind $Mod-F8 spawn brightnessctl -e set 10%-
hc keybind $Mod-F9 spawn brightnessctl -e set 10%+

# media keys, from ~/.xbindkeysrc
hc keybind XF86MonBrightnessUp spawn brightnessctl -e set 10%+
hc keybind XF86MonBrightnessDown spawn brightnessctl -e set 10%-
hc keybind XF86AudioMute spawn pactl set-sink-mute @DEFAULT_SINK@ toggle
hc keybind XF86AudioLowerVolume spawn pactl set-sink-volume @DEFAULT_SINK@ -25%
hc keybind XF86AudioRaiseVolume spawn pactl set-sink-volume @DEFAULT_SINK@ +25%
hc keybind XF86AudioMicMute spawn pactl set-source-mute @DEFAULT_SOURCE@ toggle

# colors
hc set window_border_active_color "$COLOR9"
hc set window_border_normal_color '#444444'

# settings
hc set default_frame_layout $default_frame_layout

hc set focus_follows_mouse $focus_follows_mouse
hc set focus_stealing_prevention 0
hc set raise_on_click $raise_on_click
hc set raise_on_focus $raise_on_focus
hc set raise_on_focus_temporarily $raise_on_focus_temporarily

hc set window_gap $window_gap
# one window_gap between windows, also across frames (hrwm extension)
hc set smart_gaps 1
hc set frame_gap $frame_gap
hc set frame_padding $frame_padding

hc set frame_border_width $frame_border_width
hc set window_border_width $window_border_width
hc set window_border_inner_width $window_border_inner_width
hc set frame_bg_transparent $frame_bg_transparent
hc set frame_active_opacity $frame_active_opacity
hc set frame_normal_opacity $frame_normal_opacity

# rules
hc unrule -F
#hc rule class=XTerm tag=3 # move all xterms to tag 3
hc rule focus=on # Focus new windows by default

# focus and psudotile dialogs
hc rule windowtype~'_NET_WM_WINDOW_TYPE_(DIALOG|UTILITY|SPLASH)' \
  pseudotile=on

hc rule windowtype='_NET_WM_WINDOW_TYPE_DIALOG' focus=on
hc rule windowtype~'_NET_WM_WINDOW_TYPE_(NOTIFICATION|DOCK)' manage=off

hc rule class=URxvt pseudotile=on

# unlock, just to be sure
hc unlock

hc set tree_style '╾│ ├└╼─┐'

hc detect_monitors

# --- programs (was ~/.autostart, ~/.autostart.system and panel/panel.sh) ---

# wallpaper chosen by `wp change` above
pkill -x swaybg
swaybg -m fill -i "$(readlink -f ~/.wallpapers/.current)" &

# the bar, in the current wallpaper's colors
cat > ~/.config/waybar/colors.css <<EOF
/* generated by ~/.config/hrwm/autostart from ~/.colors */
@define-color bg $COLOR0;
@define-color fg $COLOR11;
@define-color active $COLOR2;
@define-color other $COLOR3;
@define-color dim $COLOR8;
@define-color accent $COLOR9;
EOF
pkill -x waybar
waybar &

# notifications, in the same colors
mkdir -p ~/.config/mako
cat > ~/.config/mako/config <<EOF
# generated by ~/.config/hrwm/autostart from ~/.colors
font=Terminus 14px
background-color=$COLOR0
text-color=$COLOR11
border-color=$COLOR9
border-size=2
border-radius=0
padding=6
margin=6
width=360
anchor=top-right
default-timeout=6000

[urgency=high]
border-color=#df8787
default-timeout=0
EOF
pgrep -x mako >/dev/null && makoctl reload || mako &

# lock after 10 minutes idle, like xss-lock did with the X screensaver
pgrep -x swayidle >/dev/null || swayidle -w timeout 600 'swaylock -f -i ~/.wallpapers/1v3X3.jpg' &

pgrep -x dropbox >/dev/null || dropbox &
pgrep -x udiskie >/dev/null || udiskie --tray --appindicator --no-notify &
