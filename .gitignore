# Files to ignore
*.swp
*.swo
home/.vim/plugged
home/.ncmpcpp/error.log
home/.ncmpcpp/artists/

home/.wallpapers/.current

# Ignore dwb state file
config/dwb/keys.*
config/dwb/default/cookies
config/dwb/default/history
config/dwb/default/navigate.history
config/dwb/default/session
home/.vim/.netrwhist

# Fonts that must not be published: DS Bradley is licensed for private use
# only, and iosevka-custom is ~100MB of generated builds.
home/.fonts/DS_Bradley.ttf
home/.fonts/iosevka-custom/

# generated from ~/.colors by ~/.config/hrwm/autostart
config/waybar/colors.css
